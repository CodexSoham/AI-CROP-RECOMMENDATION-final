# =============================================================================
# AdaptiveCrop AI (AgroXAI) Environment Configuration
# =============================================================================

# 1. Google Gemini Generative AI (Advisory & Soil OCR Report Extraction)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. Application & Frontend URLs
APP_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:3000"

# 3. Python FastAPI ML Inference Microservice
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT="8000"
FASTAPI_SERVICE_URL="http://localhost:8000"

# 4. External Meteorological & Soil Data APIs (Default Public Endpoints)
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
NASA_POWER_API_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
SOILGRIDS_API_URL="https://rest.isric.org/soilgrids/v2.0/properties/query"

# 5. Supabase PostgreSQL Database & Auth
# Get credentials from your Supabase project dashboard: https://supabase.com/dashboard
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# 6. n8n Workflow Automation & Webhooks
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/crop-recommendation"
N8N_API_KEY="YOUR_N8N_API_KEY"

# 7. Model Context Protocol (MCP) Settings
MCP_SERVER_NAME="agroxai-engine"
MCP_LOG_LEVEL="INFO"
